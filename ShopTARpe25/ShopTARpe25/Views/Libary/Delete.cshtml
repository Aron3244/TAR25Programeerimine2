@model ShopTARpe25.Core.Domain.Book

<h2>Kas kustutada "@Model.Title"?</h2>

<form asp-action="DeleteConfirmation" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Kustuta</button>
    <a asp-action="Index" class="btn btn-secondary">Tühista</a>
</form>