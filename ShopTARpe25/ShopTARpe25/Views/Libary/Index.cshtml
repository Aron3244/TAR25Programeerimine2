@model IEnumerable<ShopTARpe25.Core.Domain.Book>

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<form method="get" class="mb-2">
    <input type="number" name="year" placeholder="Ilmumisaasta" />
    <input type="text" name="title" placeholder="Pealkiri" />
    <button class="btn btn-primary">Otsi</button>
    <a asp-action="Index">Kõik</a> |
    <a asp-action="Loaned">Laenutuses</a> |
    <a asp-action="LoanBook">Laenuta</a> |
    <a asp-action="ReaderLoans">Lugeja laenutused</a> |
    <a asp-action="CreateReader">Lisa lugeja</a>
</form>


<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>PublishedYear</th>
            <th>IsAvailable</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.PublishedYear</td>
                    <td>@item.IsAvailable</td>
                    <td>
                        <a asp-action="UpdateBookTitle" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>