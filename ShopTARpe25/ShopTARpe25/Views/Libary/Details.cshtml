@model ShopTARpe25.Core.Domain.Book

<h2>@Model.Title</h2>
<p>Autor: @Model.Author</p>
<p>Aasta: @Model.PublishedYear</p>
<p>Saadaval: @(Model.IsAvailable ? "Jah" : "Ei")</p>

<a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">Muuda</a>
<a asp-action="Index" class="btn btn-secondary">Tagasi</a>