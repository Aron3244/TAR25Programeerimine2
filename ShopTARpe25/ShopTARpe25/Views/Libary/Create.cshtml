@model ShopTARpe25.Core.Dto.BookDto

<h2>Lisa raamat</h2>

<form asp-action="Create" method="post">
    <p><input asp-for="Title" placeholder="Pealkiri" /></p>
    <p><input asp-for="Author" placeholder="Autor" /></p>
    <p><input asp-for="PublishedYear" placeholder="Aasta" /></p>
    <button type="submit" class="btn btn-success">Lisa</button>
    <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
</form>