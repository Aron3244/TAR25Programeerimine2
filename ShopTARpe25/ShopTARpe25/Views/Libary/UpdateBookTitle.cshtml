@model IEnumerable<ShopTARpe25.Core.Domain.Book>

<h2>Raamatukogu</h2>

<form method="get" asp-action="Index">
    <input type="number" name="year" placeholder="Ilmumisaasta" />
    <input type="text" name="title" placeholder="Pealkiri" />
    <button type="submit" class="btn btn-primary">Otsi</button>
</form>

<p>
    <a asp-action="Index">Kõik</a> |
    <a asp-action="Loaned">Laenutuses</a> |
    <a asp-action="Create">Lisa raamat</a> |
    <a asp-action="CreateReader">Lisa lugeja</a> |
    <a asp-action="LoanBook">Laenuta</a> |
    <a asp-action="ReaderLoans">Lugeja laenutused</a>
</p>

<table class="table">
    <tr>
        <th>Pealkiri</th>
        <th>Autor</th>
        <th>Aasta</th>
        <th>Saadaval</th>
        <th></th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Author</td>
            <td>@item.PublishedYear</td>
            <td>@(item.IsAvailable ? "Jah" : "Ei")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Vaata</a> |
                <a asp-action="Update" asp-route-id="@item.Id">Muuda</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Kustuta</a>
            </td>
        </tr>
    }
</table>