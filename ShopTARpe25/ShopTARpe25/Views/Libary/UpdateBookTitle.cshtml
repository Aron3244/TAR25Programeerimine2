@model ShopTARpe25.Core.Domain.Book

<h1>Edit Book Title</h1>

<h4>Book</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="UpdateBookTitle" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label class="control-label">Praegune autor</label>
                <input class="form-control" value="@Model.Author" disabled />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label">Uus pealkiri</label>
                <input asp-for="Title" class="form-control" name="newTitle" value="@Model.Title" />
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>