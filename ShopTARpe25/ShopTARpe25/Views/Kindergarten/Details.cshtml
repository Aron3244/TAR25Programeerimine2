@model DatabaseTask.Core.Domain.Kindergarten

@{
    ViewData["Title"] = "Detailid";
}

<h1>Rühma detailid</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Rühma nimi</dt>
        <dd class="col-sm-9">@Model.GroupName</dd>

        <dt class="col-sm-3">Laste arv</dt>
        <dd class="col-sm-9">@Model.ChildrenCount</dd>

        <dt class="col-sm-3">Lasteaia nimi</dt>
        <dd class="col-sm-9">@Model.KindergartenName</dd>

        <dt class="col-sm-3">Õpetaja nimi</dt>
        <dd class="col-sm-9">@Model.TeacherName</dd>

        <dt class="col-sm-3">Loodud</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>

        <dt class="col-sm-3">Viimati muudetud</dt>
        <dd class="col-sm-9">@Model.UpdatedAt.ToLocalTime().ToString("g")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Muuda</a>
    <a asp-action="Index" class="btn btn-secondary">Tagasi nimekirja</a>
</div>