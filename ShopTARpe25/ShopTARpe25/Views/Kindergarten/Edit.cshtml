@using Microsoft.AspNetCore.Mvc.ViewFeatures
@model ShopTARpe25.Core.Dto.KindergartenDto

@{
    ViewData["Title"] = "Muuda andmeid";
}

<h1>Muuda rühma andmeid</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div class="form-group mb-3">
                <label asp-for="GroupName" class="control-label">Rühma nimi</label>
                <input asp-for="GroupName" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="ChildrenCount" class="control-label">Laste arv</label>
                <input asp-for="ChildrenCount" type="number" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="KindergartenName" class="control-label">Lasteaia nimi</label>
                <input asp-for="KindergartenName" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="TeacherName" class="control-label">Õpetaja nimi</label>
                <input asp-for="TeacherName" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Lisa pildid</label>
                <input asp-for="Files" type="file" multiple class="form-control" />
            </div>

            <div class="form-group">
                <input type="submit" value="Salvesta muudatused" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Tagasi</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Image != null && Model.Image.Any())
{
    <hr />
    <h4>Pildid</h4>
    <div class="row">
        @foreach (var image in Model.Image)
        {
            <partial name="_Images" model="image" view-data='new ViewDataDictionary(ViewData) { { "ReturnTo", "Edit" } }' />
        }
    </div>
}